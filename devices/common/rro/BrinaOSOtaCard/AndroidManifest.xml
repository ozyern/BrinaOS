<?xml version="1.0" encoding="utf-8"?>
<!-- Static RRO: swaps the artwork behind the "About device" / OTA card in
     Settings. Priority sits above the stock overlays and above the PUI theme
     pack (4000) so it wins wherever both are installed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.brina.overlay.settings.otacard">
    <overlay
        android:targetPackage="com.android.settings"
        android:isStatic="true"
        android:priority="9000" />
    <application android:hasCode="false" />
</manifest>
